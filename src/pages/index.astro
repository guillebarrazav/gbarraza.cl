---
import BaseLayout from "../layouts/BaseLayout.astro";
import BentoGrid from "../components/BentoGrid.astro";
import BentoCard from "../components/BentoCard.astro";
import NavBar from "../components/NavBar.astro";
import Bio from "../components/Bio.astro";
import { gardenItems } from "../data/garden";
---

<BaseLayout title="Guillermo Barraza">
  <NavBar />

  <main class="mt-8 mb-20">
    <Bio />

    <div class="w-full flex justify-center px-6">
      <BentoGrid class="w-full max-w-6xl">
        {
          gardenItems.map((item) => (
            <BentoCard
              category={item.category}
              title={item.title}
              subtitle={item.subtitle}
              image={item.image}
              link={item.link}
              size={item.size}
            />
          ))
        }
      </BentoGrid>
    </div>
  </main>
</BaseLayout>
