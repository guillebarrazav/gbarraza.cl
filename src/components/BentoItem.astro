---
interface Props {
  class?: string;
  style?: string;
}

const { class: className = "", style } = Astro.props;
---

<div class:list={["px-1 pb-2", className]} style={style}>
  <article
    class:list={[
      "rounded-lg bg-[#fcfcfc] border-0",
      "h-full w-full overflow-hidden relative group transition-colors",
    ]}
  >
    <slot />
  </article>
</div>
